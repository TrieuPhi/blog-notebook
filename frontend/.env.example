# ==============================================================================
# set.log Frontend Environment Configuration
# ==============================================================================

# Site Base URL (used for canonical URLs, RSS feed absolute links, and sitemap)
# Do not include trailing slash.
VITE_SITE_URL=https://setlog.dev

# ------------------------------------------------------------------------------
# Giscus Comments Configuration (powered by GitHub Discussions)
# Setup at https://giscus.app
# ------------------------------------------------------------------------------

# GitHub repository in format "owner/repo" (must be public with Discussions enabled)
VITE_GISCUS_REPO=your-github-username/your-blog-repo

# GitHub repository ID (from GraphQL API, e.g., R_kgDOXXXXXXXXXX)
VITE_GISCUS_REPO_ID=R_kgDOXXXXXXXXXX

# GitHub Discussions category name (e.g., "Announcements" or "General")
VITE_GISCUS_CATEGORY=Announcements

# GitHub Discussions category ID (from GraphQL API, e.g., DIC_kwDOXXXXXXXXXX)
VITE_GISCUS_CATEGORY_ID=DIC_kwDOXXXXXXXXXX

# Discussion-to-page mapping strategy: "pathname" | "url" | "title" | "og:title" | "specific" | "number"
VITE_GISCUS_MAPPING=pathname

# Strict discussion title matching: "0" | "1"
VITE_GISCUS_STRICT=0

# Enable reactions for the main post: "0" | "1"
VITE_GISCUS_REACTIONS_ENABLED=1

# Emit discussion metadata: "0" | "1"
VITE_GISCUS_EMIT_METADATA=0

# Input box position: "top" | "bottom"
VITE_GISCUS_INPUT_POSITION=bottom

# Default theme: "light" | "dark" | "transparent_dark"
VITE_GISCUS_THEME=light

# Interface language: "vi" | "en"
VITE_GISCUS_LANG=vi
